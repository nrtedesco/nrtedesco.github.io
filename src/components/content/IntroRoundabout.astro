--- 
import 'swiper/css/bundle';
---

<div class="swiper mySwiper">
  <div class="swiper-wrapper">
    <div class="swiper-slide" data-title="Data Scientist">
      <img src="img/roundabout/data-scientist.jpg" alt="Data Science" />
    </div>
    <div class="swiper-slide" data-title="Trail Explorer">
      <img src="img/roundabout/acadia-climb.jpeg" alt="Hiking" />
    </div>
    <div class="swiper-slide" data-title="Self-Taught Musician">
      <img src="img/roundabout/piano.jpeg" alt="Piano" />
    </div>
    <div class="swiper-slide" data-title="Chess Player">
      <img src="img/roundabout/chess.jpeg" alt="Chess" />
    </div>
    <div class="swiper-slide" data-title="Weightlifter">
      <img src="img/roundabout/deadlift.jpeg" alt="Lifting" />
    </div>
  </div>
  <div class="swiper-pagination"></div>
</div>

<style>
  .swiper {
    width: 100%;
    padding-top: 50px;
    padding-bottom: 50px;

    --swiper-theme-color: #4682B4; 
  }

  .swiper-slide {
    background-position: center;
    background-size: cover;
    width: 300px;
    height: 300px;
  }

  .swiper-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px; 
  }
</style>

<script>
  import Swiper from 'swiper/bundle';

  new Swiper('.mySwiper', {
    effect: 'coverflow',
    grabCursor: true,
    centeredSlides: true,
    slidesPerView: 'auto',
    loop: true, 
    coverflowEffect: {
      rotate: 50,
      stretch: 0,
      depth: 100,
      modifier: 1,
      slideShadows: true,
    },
    pagination: {
      el: '.swiper-pagination',
    },
    on: {
        slideChange: function () {
          const activeSlide = this.slides[this.activeIndex];
          const newTitle = activeSlide.getAttribute('data-title');
          const titleElement = document.getElementById('dynamic-title');
          if (titleElement && newTitle) {
            titleElement.innerText = newTitle;
          }
        }
      }
  });
</script>