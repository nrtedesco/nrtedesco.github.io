---
import '../../styles/global.css';
import { localeMeta, type Locale } from '../../config/i18n';
import { siteConfig } from '../../config/site';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SearchModal from '../features/SearchModal.astro';
import Toc from '../features/Toc.astro';
import Comments from '../features/Comments.astro';
import Analytics from '../features/Analytics.astro';
import GalleryLightbox from '../features/GalleryLightbox.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  headings?: Heading[];
  toc?: boolean | 'center' | 'side';
  comments?: boolean;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  locale = 'en',
  headings = [],
  toc = false,
  comments = false
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const htmlLang = localeMeta[locale].htmlLang;
const assetBase = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
// Cache-bust so browsers pick up replaced favicon assets.
const faviconVersion = 'v2';
const faviconIco = `${assetBase}favicon.ico?${faviconVersion}`;
const faviconPng = `${assetBase}favicon-32.png?${faviconVersion}`;
const appleTouchIcon = `${assetBase}apple-touch-icon.png?${faviconVersion}`;
const emphasis = siteConfig.post.emphasis ?? {};
const rootStyle = [
  `--layout-content-width: ${siteConfig.contentWidth}`,
  emphasis.bold?.light && `--color-prose-bold: ${emphasis.bold.light}`,
  emphasis.bold?.dark && `--color-prose-bold-dark: ${emphasis.bold.dark}`,
  emphasis.italic?.light && `--color-prose-italic: ${emphasis.italic.light}`,
  emphasis.italic?.dark && `--color-prose-italic-dark: ${emphasis.italic.dark}`,
  emphasis.boldItalic?.light && `--color-prose-bold-italic: ${emphasis.boldItalic.light}`,
  emphasis.boldItalic?.dark && `--color-prose-bold-italic-dark: ${emphasis.boldItalic.dark}`
]
  .filter(Boolean)
  .join('; ');
const themeInit = `
(() => {
  const root = document.documentElement;
  try {
    const theme = localStorage.getItem('theme') || 'default';
    const mode = localStorage.getItem('color-mode');
    root.dataset.theme = theme;
    if (mode === 'dark' || (!mode && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      root.classList.add('dark');
    }
  } catch {
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) root.classList.add('dark');
  }
})();
`;
const scrollTopInit = `
(() => {
  try {
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  } catch {}
  // Home section hashes from scroll arrows should not stick across refresh.
  if (location.hash === '#home-experience' || location.hash === '#home-pinned-posts') {
    history.replaceState(null, '', location.pathname + location.search);
  }
  const toTop = () => {
    if (location.hash) return;
    window.scrollTo(0, 0);
  };
  if (document.readyState === 'complete') toTop();
  else window.addEventListener('load', toTop, { once: true });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) toTop();
  });
})();
`;
---

<!doctype html>
<html lang={htmlLang} data-theme="default" style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={faviconIco} sizes="any" />
    <link rel="icon" href={faviconPng} type="image/png" sizes="32x32" />
    <link rel="shortcut icon" href={faviconIco} />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <title>{pageTitle}</title>
    <script is:inline set:html={themeInit}></script>
    <script is:inline set:html={scrollTopInit}></script>
  </head>
  <body class="bg-background text-foreground min-h-screen antialiased">
    <main class="mx-auto min-h-screen w-full max-w-[var(--layout-content-width)] px-4">
      <Header locale={locale} />
      <slot />
      {comments && <Comments />}
      <Footer locale={locale} />
    </main>
    {toc && headings.length > 0 && <Toc headings={headings} position={toc === true ? 'center' : toc} />}
    <SearchModal locale={locale} />
    <GalleryLightbox locale={locale} />
    <Analytics />
    <script>
      import '../../scripts/theme-controls.ts';
      import '../../scripts/search.ts';
      import '../../scripts/toc.ts';
      import '../../scripts/gallery.ts';
      import '../../scripts/mermaid.ts';
      import '../../scripts/tabs.ts';
    </script>
  </body>
</html>
