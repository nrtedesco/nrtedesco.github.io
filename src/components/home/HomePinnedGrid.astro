---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../config/i18n';
import { homePinIcon, homePinLabel, type ResolvedHomePin } from '../../lib/content/home-pins';
import { useTranslations } from '../../i18n/utils';

interface Props {
  pins: ResolvedHomePin[];
  locale: Locale;
}

const { pins, locale } = Astro.props;
const t = useTranslations(locale);
---

{pins.length > 0 ? (
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {pins.map((pin) => (
      <article class="group h-full">
        <a
          href={pin.href}
          class="flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-border bg-background/40 shadow-[var(--surface-shadow)] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-primary/25 hover:bg-primary/5 hover:shadow-[var(--surface-shadow-strong)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25"
        >
          <div class="relative aspect-[16/10] overflow-hidden bg-muted">
            {pin.cover ? (
              <img
                src={pin.cover}
                alt=""
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
                loading="lazy"
              />
            ) : (
              <div class="grid h-full w-full place-items-center text-muted-foreground/50">
                <Icon name={homePinIcon(pin.type)} class="h-10 w-10" />
              </div>
            )}
            <span class="absolute top-3 right-3 rounded-md border border-border/80 bg-background/85 px-2 py-0.5 text-xs font-medium text-muted-foreground backdrop-blur-sm">
              {homePinLabel(pin.type, locale)}
            </span>
          </div>

          <div class="flex flex-1 flex-col p-5">
            <h2 class="text-base font-semibold leading-snug transition-colors group-hover:text-primary">
              {pin.title}
            </h2>

            {pin.description && (
              <p class="mt-2 line-clamp-3 flex-1 text-sm leading-6 text-muted-foreground">
                {pin.description}
              </p>
            )}

            <div class="mt-4 flex items-center justify-between gap-2 text-xs text-muted-foreground">
              {pin.type === 'series' ? (
                <span>{pin.chapterCount} {t('series.chapterCount')}</span>
              ) : (
                <span>{homePinLabel(pin.type, locale)}</span>
              )}
              <Icon
                name="lucide:arrow-right"
                class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-primary motion-reduce:transition-none"
              />
            </div>
          </div>
        </a>
      </article>
    ))}
  </div>
) : null}
