---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../config/i18n';
import type { ContentTypeId } from '../../config/content';
import { siteConfig } from '../../config/site';
import { useTranslations } from '../../i18n/utils';
import EntryList from '../content/EntryList.astro';
import ViewAll from '../ui/ViewAll.astro';
import IntroRoundabout from '../content/IntroRoundabout.astro';
import { TimelineLayout } from '../content/timeline-layout';
import HomePinnedGrid from './HomePinnedGrid.astro';
import { getHomePins } from '../../lib/content/home-pins'; 

const timelineData = [
  {
    title: "Neurobio Research Assistant",
    company: "Pitt School of Medicine",
    date: "2019 - 2020",
    description: "Performed hierarchical clustering of gene expression data. First exposures to Python and ML.",
    color: "primary"
  },
  {
    title: "Biostatistician / Analyst",
    company: "Pitt School of Public Health",
    date: "2021 - 2023",
    description: "Applied multi-level modeling in R to evaluate proximity to fracking as a predictor of adverse maternal health outcomes.",
    color: "primary"
  },
  {
    title: "Data Scientist I",
    company: "Michigan Medicine",
    date: "2023 - 2024",
    description: "Built predictive models and ETL pipelines to identify clinical predictors of liver-related outcomes.",
    color: "primary"
  },
  {
    title: "Data Scientist II",
    company: "Humana",
    date: "2024 - Present",
    description: "Implemented end-to-end ML systems to facilitate efficient business operations regarding Medicare Advantage sales.",
    color: "secondary"
  }
];

interface HomeSection {
  id: ContentTypeId;
  title: string;
  href: string;
  entries: Array<CollectionEntry<any>>;
}

interface Props {
  locale: Locale;
  sections: HomeSection[];
}

const { locale, sections } = Astro.props;
const { author } = siteConfig;
const t = useTranslations(locale);
const pinnedItems = await getHomePins(locale);
---

<section class="py-8 sm:py-10">
  <div class="profile-card surface-card px-7 py-5 sm:px-8 sm:py-6">
    <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
      <div class="min-w-0 flex-1">
        <h1 class="text-2xl tracking-tight ">
          <span class="text-muted-foreground">👋 Hello! My name is </span>
          <span class="font-bold">{author.name}</span>
          <span class="text-muted-foreground">. I'm a </span>
          <span id="dynamic-title" class="font-bold">Data Scientist</span>
          <span class="text-muted-foreground">.</span>
        </h1>
        <IntroRoundabout/>
      </div>
    </div>
  </div>

  <div class="mt-6 flex justify-center">
    <a
      href="#home-experience"
      data-home-scroll-next
      class="home-scroll-next grid h-10 w-10 place-items-center rounded-full text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      aria-label={t('home.scrollNext')}
      title={t('home.scrollNext')}
    >
      <Icon name="lucide:chevron-down" class="h-6 w-6" />
    </a>
  </div>
</section>

<section id="home-experience" class="home-section-target py-8 sm:py-10">
  <div class="profile-card surface-card px-7 py-5 sm:px-8 sm:py-6">
    <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
      <div class="min-w-0 flex-1">
        <h1 class="text-2xl tracking-tight ">
          <span class="text-muted-foreground">I have experience applying </span>
          <span class="font-bold">Machine Learning</span>
          <span class="text-muted-foreground"> across many different domains.</span>
        </h1>
        <TimelineLayout client:load items={timelineData} className="pt-16 pr-12 md:pr-32"/>
      </div>
    </div>
  </div>

  <div class="mt-6 flex justify-center">
    <a
      href="#home-pinned-posts"
      data-home-scroll-next
      class="home-scroll-next grid h-10 w-10 place-items-center rounded-full text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      aria-label={t('home.scrollNext')}
      title={t('home.scrollNext')}
    >
      <Icon name="lucide:chevron-down" class="h-6 w-6" />
    </a>
  </div>
</section>

<section id="home-pinned-posts" class="home-section-target pt-8 pb-0 sm:pt-10">
  <div class="profile-card surface-card px-7 py-5 sm:px-8 sm:py-6">
    <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
      <div class="min-w-0 flex-1">
        <h1 class="text-2xl tracking-tight ">
          <span class="text-muted-foreground">This website provides a central location for my  </span>
          <span class="font-bold">Notes, Projects, and Blog Posts</span>
          <span class="text-muted-foreground">.</span>
        </h1>
        <HomePinnedGrid pins={pinnedItems} locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .home-section-target {
    scroll-margin-top: 6rem;
  }

  .home-scroll-next {
    animation: home-scroll-bounce 1.8s ease-in-out infinite;
  }

  @keyframes home-scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(0.28rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-scroll-next {
      animation: none;
    }
  }
</style>

<script>
  // Longer than browser default, but ease-out keeps the first response snappy.
  const SCROLL_DURATION_MS = 1200;
  const SCROLLING_CLASS = 'is-programmatic-scroll';

  let scrollFrame = 0;
  let expectedScrollY = 0;
  let ignoreScrollEvent = false;

  function easeOutCubic(t: number) {
    return 1 - (1 - t) ** 3;
  }

  function stopScrollAnimation() {
    if (scrollFrame) {
      cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
    }
    document.documentElement.classList.remove(SCROLLING_CLASS);
  }

  function onUserScrollInterrupt() {
    if (!scrollFrame) return;
    stopScrollAnimation();
  }

  // Yield immediately when the user takes over scrolling.
  window.addEventListener('wheel', onUserScrollInterrupt, { passive: true });
  window.addEventListener('touchstart', onUserScrollInterrupt, { passive: true });
  window.addEventListener('keydown', (event) => {
    const keys = ['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Spacebar'];
    if (keys.includes(event.key)) onUserScrollInterrupt();
  });
  window.addEventListener(
    'scroll',
    () => {
      if (!scrollFrame || ignoreScrollEvent) return;
      // Scrollbar drag / trackpad leftovers that diverge from the animated path.
      if (Math.abs((window.scrollY || window.pageYOffset) - expectedScrollY) > 2) {
        onUserScrollInterrupt();
      }
    },
    { passive: true }
  );

  function scrollToTarget(target: HTMLElement, duration: number) {
    stopScrollAnimation();

    const start = window.scrollY || window.pageYOffset;
    const margin = Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
    const end = Math.max(0, target.getBoundingClientRect().top + start - margin);
    const distance = end - start;
    if (Math.abs(distance) < 1) return;

    // Prevent CSS scroll-behavior: smooth from fighting each rAF step.
    document.documentElement.classList.add(SCROLLING_CLASS);
    expectedScrollY = start;

    let startTime: number | null = null;

    const step = (timestamp: number) => {
      if (startTime === null) startTime = timestamp;
      const progress = Math.min((timestamp - startTime) / duration, 1);
      const nextY = start + distance * easeOutCubic(progress);

      expectedScrollY = nextY;
      ignoreScrollEvent = true;
      window.scrollTo({ top: nextY, left: 0, behavior: 'auto' });
      ignoreScrollEvent = false;

      if (progress < 1) {
        scrollFrame = requestAnimationFrame(step);
      } else {
        scrollFrame = 0;
        // Snap to the exact target in case of sub-pixel drift / layout shift.
        const settled = Math.max(
          0,
          target.getBoundingClientRect().top + (window.scrollY || window.pageYOffset) - margin
        );
        expectedScrollY = settled;
        ignoreScrollEvent = true;
        window.scrollTo({ top: settled, left: 0, behavior: 'auto' });
        ignoreScrollEvent = false;
        document.documentElement.classList.remove(SCROLLING_CLASS);
      }
    };

    scrollFrame = requestAnimationFrame(step);
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-home-scroll-next]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href');
      if (!href?.startsWith('#')) return;

      const target = document.querySelector<HTMLElement>(href);
      if (!target) return;

      event.preventDefault();

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        stopScrollAnimation();
        document.documentElement.classList.add(SCROLLING_CLASS);
        target.scrollIntoView({ behavior: 'auto', block: 'start' });
        document.documentElement.classList.remove(SCROLLING_CLASS);
      } else {
        scrollToTarget(target, SCROLL_DURATION_MS);
      }

      history.pushState(null, '', href);
    });
  });
</script>

{sections.map((section) => (
  section.entries.length > 0 && (
    <section class="py-8">
      <div class="mb-3 flex items-end justify-between gap-4">
        <h2 class="text-2xl font-semibold">{section.title}</h2>
        <ViewAll href={section.href} locale={locale} />
      </div>
      <EntryList entries={section.entries} collection={section.id} locale={locale} />
    </section>
  )
))}
